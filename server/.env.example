PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=

# Secret used to sign admin JWTs — use a long random string
JWT_SECRET=

# Cloudinary (product/request image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend origin, restricts CORS in production (falls back to allow-all if unset)
CLIENT_URL=

# SMTP for the contact form (Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
